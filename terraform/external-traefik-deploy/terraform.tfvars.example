# Name for this Pi - used as the key when calling module.pi_hardening (matters for -replace addressing).
pi_key = "traefik-external"

# Static IP this Pi is moved to, and its network's gateway/DNS.
static_ip = "172.16.0.10"
gateway = "172.16.0.1"
dns = ["1.1.1.1", "1.0.0.1"]

# This Pi's current IP before it's moved to static_ip.
bootstrap_ip = "172.16.0.152"

# Network interface nmcli manages on this Pi. Optional; defaults to "eth0".
interface = "eth0"

# Path on this Pi where Traefik's config is written and bind-mounted from. Optional; defaults to /etc/traefik.
config_path = "/etc/traefik"

# Traefik's dashboard/API via a dedicated router + basicAuth middleware, on the same
# websecure (443) entrypoint as proxied services. Optional; defaults to false. On this
# internet-facing Pi, always pair it with dashboard_allowed_ips - see the module README.
dashboard_enabled = true

# Hostname for the dashboard's Host() router rule - a real name in the Cloudflare-managed
# zone, resolved only on the LAN (no public DNS record needed). Required when dashboard_enabled.
dashboard_hostname = "external-traefik.example.com"

# Local htpasswd file gating the dashboard - see internal-traefik-deploy's example for how to
# generate one. Both Pis can share one file. Required when dashboard_enabled.
dashboard_htpasswd_path = "C:/terraform-local/dashboard-users.txt"

# Source IPs/CIDRs allowed to reach the dashboard (ipAllowList, checked before the login).
# Optional; empty allows any source - set it to the LAN ranges here.
dashboard_allowed_ips = ["192.168.1.0/24"]

# Services this Traefik instance proxies to. Each key becomes a dynamic config file
# (dynamic/<key>.yml) - Traefik's file provider watches that directory and merges every file in it.
# request_headers (optional) sets/removes request headers on that route; "" removes one.
services = {
    service = {
        hostname   = "service.example.com"
        target_url = "http://192.168.1.10:32400"
        entrypoint = "websecure"
    }
    webpage = {
        hostname        = "webpage.example.com"
        target_url      = "http://192.168.1.15"
        entrypoint      = "websecure"
        request_headers = { "X-WEBAUTH-USER" = "" }   # strip an auth-proxy header from public traffic
    }
}

# SSH user Terraform connects as (must have passwordless sudo — see pi-hardening's README).
ssh_user = "username"

# Path to the private half of the SSH key trusted on this Pi. Optional; defaults to ~/.ssh/id_ed25519.
ssh_private_key_path = "~/.ssh/id_ed25519"

# No application_ufw_name/description/ports here - Traefik's ports are Docker-published,
# which bypasses UFW's INPUT chain entirely, so a UFW app profile for them would be a no-op.
# The module still opens OpenSSH and enables UFW's default-deny-incoming baseline.

# Max failed SSH login attempts within fail2ban_findtime before an IP is banned. Optional; defaults to 4.
fail2ban_maxretry = 4

# How long a banned IP stays banned. Optional; defaults to "1h".
fail2ban_bantime = "1h"

# Time window fail2ban_maxretry is measured over. Optional; defaults to "10m".
fail2ban_findtime = "10m"

# Whether unattended-upgrades reboots this Pi on its own when an installed update needs it. Optional; defaults to true.
unattended_upgrades_auto_reboot = true

# Time of day (Pi local time) that automatic reboot is allowed to happen, if one is needed. Optional; defaults to "03:00".
unattended_upgrades_auto_reboot_time = "03:00"

# How often (in days) the daily apt-upgrade job actually runs when its systemd timer fires. Optional; defaults to 1.
auto_upgrades_days = 1

# Email Let's Encrypt uses for certificate expiry/problem notifications.
acme_email = "name@domain.com"

# Whether routers request a cert via Let's Encrypt. Optional; defaults to true - leave it
# true here, this Pi is internet-facing and uses real Let's Encrypt certs.
use_acme = true

# Path to a local file containing a Cloudflare API token (Zone:DNS:Edit scope on the
# relevant zone only, not full account access) used for the ACME DNS-01 challenge. Keep
# this file outside the repo - only the path is a Terraform value, the token itself is
# pushed to this Pi as a root-owned file (chmod 600) and never becomes Terraform state.
cf_api_token_path = "C:/terraform-local/cf-token-external.txt"
