entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: ${acme_email}
      storage: /etc/traefik/acme/acme.json
      dnsChallenge:
        provider: cloudflare

%{ if dashboard_enabled ~}
api: {}
%{ endif ~}
