http:
  routers:
    ${name}:
      rule: "Host(`${hostname}`)"
      entryPoints:
        - ${entrypoint}
      service: ${name}
%{ if length(request_headers) > 0 ~}
      middlewares:
        - ${name}-headers
%{ endif ~}
%{ if use_acme ~}
      tls:
        certResolver: letsencrypt
%{ else ~}
      tls: {}
%{ endif ~}

  services:
    ${name}:
      loadBalancer:
        servers:
          - url: "${target_url}"
%{ if length(request_headers) > 0 ~}

  middlewares:
    ${name}-headers:
      headers:
        customRequestHeaders:
%{ for k, v in request_headers ~}
          ${k}: "${v}"
%{ endfor ~}
%{ endif ~}
