%{ if role == "external" && acme_email != null ~}
{
	email ${acme_email}
}

%{ endif ~}
%{ for site in sites ~}
${site.hostname} {
	%{ if role == "internal" ~}
	tls internal
	%{ endif ~}
	%{ if role == "external" ~}
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}
	%{ endif ~}
	reverse_proxy ${site.upstream}
}

%{ endfor ~}