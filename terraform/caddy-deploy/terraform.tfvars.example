# Map of Raspberry Pis this module hardens and configures. Each key is an
# arbitrary name you choose (used in resource addresses, e.g. for -replace).
pi_hosts = {
    caddy-proxy-external = {
        static_ip = "172.16.0.10"
        gateway = "172.16.0.1"
        dns = ["1.1.1.1", "1.0.0.1"]     # optional; defaults to the Pi-holes in variables.tf if omitted
        bootstrap_ip = "172.16.0.152"    # this Pi's current IP before it's moved to static_ip
        role = "external"                # "external" = real Let's Encrypt certs via Cloudflare DNS-01
        sites = [
            {
                hostname = "service.domain.com"
                upstream = "192.168.1.10:32400"
            },
            {
                hostname = "webpage.domain.com"
                upstream = "192.168.1.15"
            }

        ]
    }
    caddy-proxy-internal = {
        static_ip = "192.168.0.5"
        gateway = "192.168.0.1"
        bootstrap_ip = "192.168.0.155"
        role = "internal"                # "internal" = Caddy's own self-signed CA, LAN-only
        sites = [
            {
                hostname = "service.internal"
                upstream = "192.168.0.16:3000"
            },
            {
                hostname = "webpage.internal"
                upstream = "192.168.0.15"
            }
        ]
    }
}

# SSH user Terraform connects as on every Pi (must have passwordless sudo — see README).
ssh_user = "username"

# Path to the private half of the SSH key trusted on each Pi. Optional; defaults to ~/.ssh/id_ed25519.
ssh_private_key_path = "~/.ssh/id_ed25519"

# Name of the app UFW should allow through the firewall (becomes the UFW app profile name, e.g. "Caddy").
application_ufw_name = "Caddy"

# Human-readable description stored in that UFW app profile.
application_ufw_description = "Caddy reverse proxy"

# Ports that app profile opens. Caddy's admin API (2019/tcp) is optional — only add it if you need remote admin access.
application_ufw_ports = ["80/tcp", "443/tcp"]

# Max failed SSH login attempts within fail2ban_findtime before an IP is banned. Optional; defaults to 4.
fail2ban_maxretry = 4

# How long a banned IP stays banned. Optional; defaults to "1h".
fail2ban_bantime = "1h"

# Time window fail2ban_maxretry is measured over. Optional; defaults to "10m".
fail2ban_findtime = "10m"

# Whether unattended-upgrades reboots a Pi on its own when an installed update needs it. Optional; defaults to true.
unattended_upgrades_auto_reboot = true

# Time of day (Pi local time) that automatic reboot is allowed to happen, if one is needed. Optional; defaults to "03:00".
unattended_upgrades_auto_reboot_time = "03:00"

# How often (in days) the daily apt-upgrade job actually runs when its systemd timer fires. Optional; defaults to 1.
auto_upgrades_days = 1

# Email Let's Encrypt uses for certificate expiry/problem notifications.
acme_email = "name@domain.com"

# Cloudflare API token (Zone:DNS:Edit) used for DNS-01 challenges on external sites. Keep this out of version control.
cloudflare_api_token = "apitoken"